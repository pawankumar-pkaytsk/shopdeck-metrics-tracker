{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] },
    { "source": "/main.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }] }
  ]
}
